# Live discovery only. Replay and offline demos require no model configuration.
HANDRAIL_PLANNER_PROVIDER=ollama
HANDRAIL_OLLAMA_BASE_URL=http://127.0.0.1:11434
HANDRAIL_MODEL=qwen3:4b
HANDRAIL_INCLUDE_SCREENSHOT=false
HANDRAIL_MODEL_TIMEOUT_MS=45000

# Alternative OpenAI-compatible endpoint (opt in with
# HANDRAIL_PLANNER_PROVIDER=openai-compatible).
# LLM_BASE_URL=http://127.0.0.1:8110/v1
# LLM_API_KEY=
# LLM_MODEL=
# HANDRAIL_PROVIDER_NAME=openai-compatible-local

# Optional runtime defaults.
HANDRAIL_HEADLESS=true
HANDRAIL_EVIDENCE_DIR=evidence/.staging
